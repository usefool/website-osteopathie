---
/**
 * Base Layout - S7 Erdtöne Theme
 * Mobile Kinderosteopathie Leipzig - Susanne Hoppe
 */

import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { t, type Lang } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description,
  lang = 'de',
} = Astro.props;

// Default descriptions per language
const defaultDescription = lang === 'de'
  ? 'Mobile Kinderosteopathie in Leipzig - Susanne Hoppe. Osteopathische Behandlung für Ihr Kind bei Ihnen zuhause.'
  : 'Mobile pediatric osteopathy in Leipzig - Susanne Hoppe. Osteopathic treatment for your child at your home.';

const finalDescription = description || defaultDescription;

const siteTitle = lang === 'de'
  ? 'Susanne Hoppe - Mobile Kinderosteopathie Leipzig'
  : 'Susanne Hoppe - Mobile Pediatric Osteopathy Leipzig';
const fullTitle = title === 'Home' ? siteTitle : `${title} | ${siteTitle}`;
const siteUrl = 'https://kinderosteopathie-leipzig.de';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = `${siteUrl}/og-image.jpg`;

// Navigation items per language
const navItems = lang === 'de'
  ? [
      { href: '/', label: 'Home' },
      { href: '/ueber-mich', label: 'Über mich' },
      { href: '/leistungen', label: 'Leistungen' },
      { href: '/kontakt', label: 'Kontakt' },
    ]
  : [
      { href: '/en', label: 'Home' },
      { href: '/en/about', label: 'About' },
      { href: '/en/services', label: 'Services' },
      { href: '/en/contact', label: 'Contact' },
    ];

// Legal links per language
const legalLinks = lang === 'de'
  ? [
      { href: '/impressum', label: 'Impressum' },
      { href: '/datenschutz', label: 'Datenschutz' },
    ]
  : [
      { href: '/en/imprint', label: 'Imprint' },
      { href: '/en/privacy', label: 'Privacy Policy' },
    ];

// hreflang URL mappings
const hreflangUrls: Record<string, { de: string; en: string }> = {
  '/': { de: '/', en: '/en' },
  '/en': { de: '/', en: '/en' },
  '/ueber-mich': { de: '/ueber-mich', en: '/en/about' },
  '/en/about': { de: '/ueber-mich', en: '/en/about' },
  '/leistungen': { de: '/leistungen', en: '/en/services' },
  '/en/services': { de: '/leistungen', en: '/en/services' },
  '/kontakt': { de: '/kontakt', en: '/en/contact' },
  '/en/contact': { de: '/kontakt', en: '/en/contact' },
  '/impressum': { de: '/impressum', en: '/en/imprint' },
  '/en/imprint': { de: '/impressum', en: '/en/imprint' },
  '/datenschutz': { de: '/datenschutz', en: '/en/privacy' },
  '/en/privacy': { de: '/datenschutz', en: '/en/privacy' },
};

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const hreflang = hreflangUrls[normalizedPath] || { de: '/', en: '/en' };

// Accessibility labels per language
const a11y = {
  skipToContent: lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content',
  openMenu: lang === 'de' ? 'Menü öffnen' : 'Open menu',
};

// Footer text
const footerText = {
  tagline: lang === 'de'
    ? 'Kinderphysiotherapeutin | Kinderosteopathie'
    : 'Pediatric Physiotherapist | Pediatric Osteopathy',
  navigation: lang === 'de' ? 'Navigation' : 'Navigation',
  legal: lang === 'de' ? 'Rechtliches' : 'Legal',
  copyright: lang === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.',
  disclaimer: lang === 'de'
    ? 'Die osteopathischen Behandlungen erfolgen auf Grundlage einer ärztlichen Verordnung und stellen keine Heilversprechen dar. Ein Behandlungserfolg kann nicht garantiert werden.'
    : 'Osteopathic treatments are provided on the basis of a medical prescription and do not constitute a promise of cure. Treatment success cannot be guaranteed.',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={finalDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- hreflang tags for language variants -->
    <link rel="alternate" hreflang="de" href={`${siteUrl}${hreflang.de}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${hreflang.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${hreflang.de}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'de' ? 'Susanne Hoppe - Mobile Kinderosteopathie Leipzig' : 'Susanne Hoppe - Mobile Pediatric Osteopathy Leipzig'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": siteUrl,
      "name": "Susanne Hoppe - Mobile Kinderosteopathie Leipzig",
      "description": "Mobile osteopathische Behandlung für Säuglinge, Kinder und Familien in Leipzig. Sanfte, kindgerechte Osteopathie bei Ihnen zuhause.",
      "url": siteUrl,
      "telephone": "",
      "email": "",
      "image": ogImageUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Leipzig",
        "addressRegion": "Sachsen",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "51.3397",
        "longitude": "12.3731"
      },
      "areaServed": {
        "@type": "City",
        "name": "Leipzig"
      },
      "priceRange": "€€",
      "serviceType": ["Kinderosteopathie", "Säuglingsosteopathie", "Mobile Osteopathie", "Hausbesuche"],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Säuglinge",
            "description": "Sanfte osteopathische Behandlung für Babys von 0-12 Monaten"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Kleinkinder",
            "description": "Osteopathische Behandlung für Kinder von 1-6 Jahren"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Schulkinder",
            "description": "Osteopathische Behandlung für Kinder von 6-14 Jahren"
          }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{a11y.skipToContent}</a>

    <header class="header">
      <div class="container header-inner">
        <a href={lang === 'de' ? '/' : '/en'} class="logo">Susanne Hoppe</a>

        <nav class="nav-desktop">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-link ${normalizedPath === item.href ? 'active' : ''}`}
            >
              {item.label}
            </a>
          ))}
          <LanguageSwitcher lang={lang} currentPath={currentPath} />
        </nav>

        <div class="mobile-header-right">
          <LanguageSwitcher lang={lang} currentPath={currentPath} />
          <button class="menu-toggle" aria-label={a11y.openMenu} aria-expanded="false">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="nav-mobile">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-mobile-link ${normalizedPath === item.href ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>Susanne Hoppe</h3>
            <p>{footerText.tagline}</p>
          </div>

          <div class="footer-nav">
            <h3>{footerText.navigation}</h3>
            <ul>
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-legal">
            <h3>{footerText.legal}</h3>
            <ul>
              {legalLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Susanne Hoppe. {footerText.copyright}</p>
          <p class="footer-disclaimer">{footerText.disclaimer}</p>
        </div>
      </div>
    </footer>

    <style is:global>
      @import '../styles/global.css';

      /* ============================================
         HEADER
         ============================================ */

      .skip-link {
        position: absolute;
        top: -100%;
        left: 16px;
        background: var(--color-accent);
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        z-index: 1000;
        transition: top 0.2s;
      }

      .skip-link:focus {
        top: 16px;
      }

      .header {
        position: sticky;
        top: 0;
        background: rgba(250, 246, 241, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(198, 125, 90, 0.12);
        z-index: 100;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s;
      }

      .logo:hover {
        color: var(--color-accent);
      }

      /* Desktop Navigation */
      .nav-desktop {
        display: none;
        gap: 32px;
      }

      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--color-accent);
      }

      /* Mobile Header Right (lang switcher + menu toggle) */
      .mobile-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* Mobile Menu Toggle */
      .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-text);
      }

      .menu-toggle svg {
        width: 24px;
        height: 24px;
      }

      .menu-toggle .close-icon {
        display: none;
      }

      .menu-toggle[aria-expanded="true"] .menu-icon {
        display: none;
      }

      .menu-toggle[aria-expanded="true"] .close-icon {
        display: block;
      }

      /* Mobile Navigation */
      .nav-mobile {
        display: none;
        flex-direction: column;
        padding: 16px var(--container-padding) 24px;
        border-top: 1px solid rgba(198, 125, 90, 0.15);
        background: rgba(250, 246, 241, 0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .nav-mobile.open {
        display: flex;
      }

      .nav-mobile-link {
        display: block;
        padding: 14px 0;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        border-bottom: 1px solid var(--color-border-light);
      }

      .nav-mobile-link:last-child {
        border-bottom: none;
      }

      .nav-mobile-link:hover,
      .nav-mobile-link.active {
        color: var(--color-accent);
      }

      /* ============================================
         FOOTER
         ============================================ */

      .footer {
        background: var(--color-bg-alt);
        border-top: 1px solid var(--color-border);
        padding: 48px 0 32px;
        margin-top: auto;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px 16px;
      }

      .footer-brand {
        grid-column: 1 / -1;
      }

      .footer h3 {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 12px;
        color: var(--color-text);
      }

      .footer-brand p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0;
      }

      .footer-nav ul,
      .footer-legal ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer-nav li,
      .footer-legal li {
        margin-bottom: 8px;
      }

      .footer-nav a,
      .footer-legal a {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-nav a:hover,
      .footer-legal a:hover {
        color: var(--color-accent);
      }

      .footer-bottom {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
        text-align: center;
      }

      .footer-bottom p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin: 0;
      }

      .footer-disclaimer {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        opacity: 0.7;
        margin-top: 12px !important;
        line-height: 1.5;
        padding: 0 20%;
      }

      /* ============================================
         RESPONSIVE
         ============================================ */

      @media (min-width: 768px) {
        .nav-desktop {
          display: flex;
        }

        .mobile-header-right {
          display: none;
        }

        .menu-toggle {
          display: none;
        }

        .nav-mobile {
          display: none !important;
        }

        .footer-grid {
          grid-template-columns: 2fr 1fr 1fr;
          gap: 32px;
        }

        .footer-brand {
          grid-column: auto;
        }
      }
    </style>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const navMobile = document.querySelector('.nav-mobile');

      if (menuToggle && navMobile) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          navMobile.classList.toggle('open');
        });
      }
    </script>
  </body>
</html>

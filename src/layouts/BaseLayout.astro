---
/**
 * Base Layout - S7 Erdtöne Theme
 * Mobile Kinderosteopathie Leipzig - Susanne Hoppe
 */

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Mobile Kinderosteopathie in Leipzig - Susanne Hoppe. Osteopathische Behandlung für Ihr Kind bei Ihnen zuhause.',
} = Astro.props;

const siteTitle = 'Susanne Hoppe - Mobile Kinderosteopathie Leipzig';
const fullTitle = title === 'Home' ? siteTitle : `${title} | ${siteTitle}`;
const siteUrl = 'https://kinderosteopathie-leipzig.de';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = `${siteUrl}/og-image.jpg`;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/ueber-mich', label: 'Über mich' },
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Susanne Hoppe - Mobile Kinderosteopathie Leipzig" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": siteUrl,
      "name": "Susanne Hoppe - Mobile Kinderosteopathie Leipzig",
      "description": "Mobile osteopathische Behandlung für Säuglinge, Kinder und Familien in Leipzig. Sanfte, kindgerechte Osteopathie bei Ihnen zuhause.",
      "url": siteUrl,
      "telephone": "",
      "email": "",
      "image": ogImageUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Leipzig",
        "addressRegion": "Sachsen",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "51.3397",
        "longitude": "12.3731"
      },
      "areaServed": {
        "@type": "City",
        "name": "Leipzig"
      },
      "priceRange": "€€",
      "serviceType": ["Kinderosteopathie", "Säuglingsosteopathie", "Mobile Osteopathie", "Hausbesuche"],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Säuglinge",
            "description": "Sanfte osteopathische Behandlung für Babys von 0-12 Monaten"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Kleinkinder",
            "description": "Osteopathische Behandlung für Kinder von 1-6 Jahren"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Osteopathie für Schulkinder",
            "description": "Osteopathische Behandlung für Kinder von 6-14 Jahren"
          }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>

    <header class="header">
      <div class="container header-inner">
        <a href="/" class="logo">Susanne Hoppe</a>

        <nav class="nav-desktop">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="nav-mobile">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-mobile-link ${currentPath === item.href ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>Susanne Hoppe</h3>
            <p>Kinderphysiotherapeutin | Kinderosteopathie</p>
          </div>

          <div class="footer-nav">
            <h3>Navigation</h3>
            <ul>
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-legal">
            <h3>Rechtliches</h3>
            <ul>
              <li><a href="/impressum">Impressum</a></li>
              <li><a href="/datenschutz">Datenschutz</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Susanne Hoppe. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>

    <style is:global>
      @import '../styles/global.css';

      /* ============================================
         HEADER
         ============================================ */

      .skip-link {
        position: absolute;
        top: -100%;
        left: 16px;
        background: var(--color-accent);
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        z-index: 1000;
        transition: top 0.2s;
      }

      .skip-link:focus {
        top: 16px;
      }

      .header {
        position: sticky;
        top: 0;
        background: rgba(250, 246, 241, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(198, 125, 90, 0.12);
        z-index: 100;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s;
      }

      .logo:hover {
        color: var(--color-accent);
      }

      /* Desktop Navigation */
      .nav-desktop {
        display: none;
        gap: 32px;
      }

      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--color-accent);
      }

      /* Mobile Menu Toggle */
      .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-text);
      }

      .menu-toggle svg {
        width: 24px;
        height: 24px;
      }

      .menu-toggle .close-icon {
        display: none;
      }

      .menu-toggle[aria-expanded="true"] .menu-icon {
        display: none;
      }

      .menu-toggle[aria-expanded="true"] .close-icon {
        display: block;
      }

      /* Mobile Navigation */
      .nav-mobile {
        display: none;
        flex-direction: column;
        padding: 16px var(--container-padding) 24px;
        border-top: 1px solid rgba(198, 125, 90, 0.15);
        background: rgba(250, 246, 241, 0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .nav-mobile.open {
        display: flex;
      }

      .nav-mobile-link {
        display: block;
        padding: 14px 0;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        border-bottom: 1px solid var(--color-border-light);
      }

      .nav-mobile-link:last-child {
        border-bottom: none;
      }

      .nav-mobile-link:hover,
      .nav-mobile-link.active {
        color: var(--color-accent);
      }

      /* ============================================
         FOOTER
         ============================================ */

      .footer {
        background: var(--color-bg-alt);
        border-top: 1px solid var(--color-border);
        padding: 48px 0 32px;
        margin-top: auto;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .footer h3 {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 12px;
        color: var(--color-text);
      }

      .footer-brand p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0;
      }

      .footer-nav ul,
      .footer-legal ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer-nav li,
      .footer-legal li {
        margin-bottom: 8px;
      }

      .footer-nav a,
      .footer-legal a {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-nav a:hover,
      .footer-legal a:hover {
        color: var(--color-accent);
      }

      .footer-bottom {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
        text-align: center;
      }

      .footer-bottom p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin: 0;
      }

      /* ============================================
         RESPONSIVE
         ============================================ */

      @media (min-width: 768px) {
        .nav-desktop {
          display: flex;
        }

        .menu-toggle {
          display: none;
        }

        .nav-mobile {
          display: none !important;
        }

        .footer-grid {
          grid-template-columns: 2fr 1fr 1fr;
        }
      }
    </style>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const navMobile = document.querySelector('.nav-mobile');

      if (menuToggle && navMobile) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          navMobile.classList.toggle('open');
        });
      }
    </script>
  </body>
</html>

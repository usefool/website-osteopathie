---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Me"
  description="Susanne Hoppe - Pediatric physiotherapist with many years of experience and certified pediatric osteopath in Leipzig."
  lang="en"
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-image">
          <img
            src="/susanne_new.jpeg"
            alt="Susanne Hoppe – Osteopath for newborns and mothers"
            class="about-photo"
          />
        </div>

        <div class="hero-content">
          <h1>About <span class="accent">Me</span></h1>
          <p>
            Since 2002, I have been working with great passion as a physiotherapist in Leipzig –
            first in various practices, and since 2016 at the University Hospital Leipzig.
          </p>
          <p>
            There, together with families, I accompany small patients
            on their journey: arriving in life and recovering. This togetherness
            is close to my heart, and I am deeply grateful for the trust of the parents.
          </p>
          <p>
            Over the years, I have continuously furthered my education in osteopathic treatments.
            These complement my neurophysiological and family-oriented
            Bobath approach in a valuable way.
          </p>
          <p>
            Time and again, families asked me if I could continue to accompany their children
            after their hospital stay. In 2025, I therefore became self-employed on a part-time basis.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- My Focus -->
  <section class="section section-alt">
    <div class="container">
      <div class="split-section split-reverse">
        <div class="split-content">
          <h2>My <span class="accent">Focus</span></h2>
          <p>
            My focus is on osteopathic treatment of preterm babies,
            newborns, and infants – gladly also at your home, where the little ones
            feel most comfortable and can relax best. Treatment of
            mothers is also naturally part of my work.
          </p>
          <p>
            At the center of my work is not only the child, but the whole family.
            Every treatment begins with attentive listening and a careful case history to build trust and security.
          </p>
          <p>
            As a mother of two children, I know from my own experience what challenges
            and uncertainties the first months of life can bring. This helps me
            accompany families with understanding.
          </p>
        </div>
        <div class="split-image">
          <div class="photo-slideshow">
            <img
              src="/susanne_inkubator.webp"
              alt="Susanne Hoppe working with a baby in an incubator"
              class="split-photo slideshow-img"
            />
            <img
              src="/susanne_haende.webp"
              alt="Gentle hands during osteopathic treatment"
              class="split-photo slideshow-img"
            />
            <img
              src="/inkubator_hinten.webp"
              alt="Susanne Hoppe working at the incubator"
              class="split-photo slideshow-img"
            />
            <img
              src="/susanne_lachen.webp"
              alt="Susanne Hoppe smiling"
              class="split-photo slideshow-img"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Qualifications -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>My <span class="accent">Qualifications</span></h2>
      </div>

      <div class="qualifications-grid">
        <div class="card qualification-card">
          <div class="qualification-header">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
              </svg>
            </div>
            <h3>Basic Training</h3>
          </div>
          <ul class="qualification-list">
            <li>
              <span class="year">2002</span>
              <span>State-certified Physiotherapist</span>
            </li>
          </ul>
        </div>

        <div class="card qualification-card">
          <div class="qualification-header">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
              </svg>
            </div>
            <h3>Osteopathy</h3>
          </div>
          <ul class="qualification-list">
            <li>
              <span class="year">2017</span>
              <span>Completion of Osteopathy Training (Eumetis)</span>
            </li>
            <li>
              <span class="year">2025</span>
              <span>Pediatric Osteopathy (IFAO)</span>
            </li>
          </ul>
        </div>

        <div class="card qualification-card qualification-card-wide">
          <div class="qualification-header">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <h3>Further Training</h3>
          </div>
          <ul class="qualification-tags">
            <li>Manual Therapy</li>
            <li>Lymphatic Therapy</li>
            <li>Bobath Therapy (Children & Adults)</li>
            <li>Pain Therapy (Hockenholz Teaching Team)</li>
            <li>Kinesiotaping</li>
            <li>Respiratory Therapy in Pediatrics</li>
            <li>Intensive Care Physiotherapy (DIVI)</li>
            <li>Annual First Aid Course for Children</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Continuing Education & Networking -->
  <section class="section section-alt">
    <div class="container">
      <div class="networking-content">
        <h2>Knowledge Grows Through <span class="accent">Exchange</span></h2>
        <p>
          Regular conferences and continuing education as well as interdisciplinary exchange
          with colleagues are important to me in order to always be able to offer my small patients
          the best possible treatment.
        </p>
        <p>
          The close exchange with doctors, nurses, and other therapists –
          and not least with you as parents – enriches my work and makes it
          a little better every day.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Let's Get to <span class="accent">Know</span> Each Other</h2>
        <p>
          Would you like to learn more about my work or have questions about osteopathic
          treatment for your child? I look forward to hearing from you.
        </p>
        <a href="/en/contact" class="btn btn-primary">
          Get in Touch
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  .hero-image {
    max-width: 320px;
    margin: 0 auto;
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: left top;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(61, 46, 36, 0.12);
    transform: rotate(-2deg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    filter: saturate(0.5) contrast(0.95) brightness(1.05);
  }

  .about-photo:hover {
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0 12px 32px rgba(61, 46, 36, 0.18);
  }

  .hero-content .tag-handwritten {
    margin-bottom: 16px;
  }

  .hero-content h1 {
    font-size: 2.5rem;
    margin-bottom: 24px;
  }

  .hero-content p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .hero-content p:last-child {
    margin-bottom: 0;
  }

  /* ============================================
     SECTIONS
     ============================================ */

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-header h2 {
    margin-bottom: 12px;
  }

  /* ============================================
     SPLIT SECTION (My Focus)
     ============================================ */

  .split-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .split-content h2 {
    margin-bottom: 20px;
  }

  .split-content > p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .split-content > p:last-of-type {
    margin-bottom: 0;
  }

  .split-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(61, 46, 36, 0.12);
    transform: rotate(2deg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    filter: saturate(0.5) contrast(0.95) brightness(1.05);
  }

  .split-photo:hover {
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0 12px 32px rgba(61, 46, 36, 0.18);
  }

  /* Photo Slideshow */
  .photo-slideshow {
    position: relative;
    width: 85%;
    margin: 0 auto;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 16px;
  }

  .photo-slideshow .slideshow-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: fadeSlide 28s ease-in-out infinite;
  }

  /* Individual positioning & rotation per image (Photostack) */
  .photo-slideshow .slideshow-img:nth-child(1) {
    animation-delay: 0s;
    object-position: 30% center;
    transform: rotate(-3.5deg) scale(1.1);
  }
  .photo-slideshow .slideshow-img:nth-child(2) {
    animation-delay: 7s;
    object-position: center 40%;
    transform: rotate(2.5deg) scale(1.1);
  }
  .photo-slideshow .slideshow-img:nth-child(3) {
    animation-delay: 14s;
    object-position: 70% center;
    transform: rotate(4deg) scale(1.1);
  }
  .photo-slideshow .slideshow-img:nth-child(4) {
    animation-delay: 21s;
    object-position: center 30%;
    transform: rotate(-2deg) scale(1.1);
  }

  @keyframes fadeSlide {
    0% { opacity: 0; }
    4% { opacity: 1; }
    21% { opacity: 1; }
    25% { opacity: 0; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-slideshow .slideshow-img {
      animation: none;
    }
    .photo-slideshow .slideshow-img:first-child {
      opacity: 1;
    }
  }

  /* ============================================
     QUALIFICATIONS
     ============================================ */

  .qualifications-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .qualification-card {
    padding: 28px;
  }

  .qualification-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .qualification-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .qualification-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .qualification-list li {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .qualification-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .qualification-list li:first-child {
    padding-top: 0;
  }

  .qualification-list .year {
    font-weight: 600;
    color: var(--color-accent);
    min-width: 48px;
  }

  .qualification-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .qualification-tags li {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .qualification-tags li:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ============================================
     NETWORKING
     ============================================ */

  .networking-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .networking-content .tag-handwritten {
    margin-bottom: 16px;
  }

  .networking-content h2 {
    margin-bottom: 24px;
  }

  .networking-content > p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .networking-content > p:last-child {
    margin-bottom: 0;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
    color: var(--color-text);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .check-list li:last-child {
    margin-bottom: 0;
  }

  .check-list svg {
    width: 24px;
    height: 24px;
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ============================================
     CTA
     ============================================ */

  .cta-section {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .cta-content {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: 16px;
  }

  .cta-content > p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 32px;
  }

  .cta-content svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 640px) {
    .qualifications-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .qualification-card-wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding: 80px 0 100px;
    }

    .hero-grid {
      grid-template-columns: 320px 1fr;
      gap: 64px;
      align-items: center;
    }

    .hero-image {
      max-width: none;
    }

    .hero-content h1 {
      font-size: 3rem;
    }

    .split-section {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }

    .split-reverse {
      direction: rtl;
    }

    .split-reverse > * {
      direction: ltr;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 360px 1fr;
      gap: 80px;
    }

    .hero-content h1 {
      font-size: 3.5rem;
    }
  }

  /* Very small screens (<400px) */
  @media (max-width: 399px) {
    .hero {
      padding: 32px 0 48px;
    }

    .hero-image {
      max-width: 260px;
    }

    .hero-content h1 {
      font-size: 2rem;
    }

    .hero-content p {
      font-size: 1rem;
    }

    /* Slideshow: full width on small screens */
    .photo-slideshow {
      width: 100%;
    }

    .split-content > p {
      font-size: 1rem;
    }

    /* Qualifications */
    .qualification-card {
      padding: 20px;
    }

    .qualification-header h3 {
      font-size: 1.1rem;
    }

    .qualification-tags li {
      padding: 6px 12px;
      font-size: 0.85rem;
    }

    /* Networking */
    .networking-content > p {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { initScrollAnimations } from '../../scripts/scroll-animations';
  initScrollAnimations();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Leistungen"
  description="Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien - sanft, kindgerecht und bei Ihnen zuhause in Leipzig."
>
  <!-- Leistungen -->
  <section class="section section-alt first-section">
    <div class="container">
      <div class="section-header">
        <span class="tag-handwritten brush-2">Individuell betreut</span>
        <h2>Für jedes Alter die richtige <span class="accent">Begleitung</span></h2>
      </div>

      <div class="services-list">
        <!-- Früh- & Neugeborene -->
        <div class="service-card">
          <div class="service-header">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div class="service-title">
              <h3>Früh- & Neugeborene</h3>
              <p class="service-subtitle">Behutsame Begleitung der Allerkleinsten</p>
            </div>
          </div>
          <div class="service-body">
            <h4>Häufige Behandlungsanlässe</h4>
            <ul class="treatment-list">
              <li>Nach Frühgeburt</li>
              <li>Anpassungs- und Regulationsstörungen</li>
              <li>Atemauffälligkeiten</li>
              <li>Nach chirurgischen Eingriffen</li>
              <li>Trink- und Verdauungsprobleme</li>
              <li>Schädel- und Haltungsasymmetrien</li>
              <li>Schwierige Geburt (Saugglocke, Kaiserschnitt, lange Geburt)</li>
            </ul>
          </div>
        </div>

        <!-- Säuglinge -->
        <div class="service-card">
          <div class="service-header">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" />
                <circle cx="12" cy="12" r="4" />
              </svg>
            </div>
            <div class="service-title">
              <h3>Säuglinge</h3>
              <p class="service-subtitle">Sanfte Behandlung im ersten Lebensjahr</p>
            </div>
          </div>
          <div class="service-body">
            <h4>Häufige Behandlungsanlässe</h4>
            <ul class="treatment-list">
              <li>Schlafstörungen, Unruhe</li>
              <li>Koliken, Blähungen, Verdauungsprobleme</li>
              <li>Schwierigkeiten mit Stillen und Saugen</li>
              <li>Schiefhals, Kiss-Syndrom</li>
              <li>Haltungsasymmetrien</li>
              <li>Entwicklungsverzögerungen</li>
              <li>Nach chirurgischen Eingriffen</li>
            </ul>
          </div>
        </div>

        <!-- Mütter -->
        <div class="service-card">
          <div class="service-header">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
              </svg>
            </div>
            <div class="service-title">
              <h3>Mütter</h3>
              <p class="service-subtitle">Behandlung im Wochenbett und darüber hinaus</p>
            </div>
          </div>
          <div class="service-body">
            <h4>Häufige Behandlungsanlässe</h4>
            <ul class="treatment-list">
              <li>Rückbildung und Beckenbodenbeschwerden</li>
              <li>Rückenschmerzen, Verspannungen</li>
              <li>Narbenbehandlung (Kaiserschnitt, Dammriss)</li>
              <li>Stillprobleme</li>
              <li>Erschöpfung und Erholung</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kosten -->
  <section class="section">
    <div class="container">
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Behandlungskosten</h3>
        </div>

        <div class="pricing-body">
          <div class="pricing-items">
            <div class="pricing-item">
              <div class="pricing-label">
                <span class="pricing-name">Erstbehandlung</span>
                <span class="pricing-duration">ca. 60 Min</span>
              </div>
              <span class="pricing-amount">95 €</span>
            </div>

            <div class="pricing-item">
              <div class="pricing-label">
                <span class="pricing-name">Folgebehandlung</span>
                <span class="pricing-duration">ca. 45–60 Min</span>
              </div>
              <span class="pricing-amount">90 €</span>
            </div>

            <div class="pricing-item">
              <div class="pricing-label">
                <span class="pricing-name">Anfahrt Plagwitz, Lindenau, Schleußig</span>
              </div>
              <span class="pricing-included">inklusive</span>
            </div>

            <div class="pricing-item">
              <div class="pricing-label">
                <span class="pricing-name">Anfahrt andere Stadtteile</span>
              </div>
              <span class="pricing-included">nach Absprache</span>
            </div>
          </div>

          <div class="pricing-info">
            <h4>Erstattung durch Krankenkassen</h4>
            <p>
              Osteopathische Behandlungen sind <strong>prinzipiell erstattungsfähig</strong>.
              Viele gesetzliche und private Krankenkassen übernehmen die Kosten anteilig oder vollständig.
            </p>
            <p>
              Sie erhalten nach jeder Behandlung eine Rechnung zur Einreichung bei Ihrer Krankenkasse.
            </p>
            <p class="pricing-note">
              Bitte informieren Sie sich vor der ersten Behandlung bei Ihrer Krankenkasse über die Erstattungsmöglichkeiten.
              <a href="https://www.osteopathie-krankenkasse.de/kostenuebernahme/" target="_blank" rel="noopener" class="pricing-link">Übersicht: Welche Kasse erstattet was?</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Termin <span class="accent">anfragen</span></h2>
        <p>
          Ich freue mich darauf, Ihr Kind und Ihre Familie kennenzulernen.
          Kontaktieren Sie mich gerne für ein unverbindliches Erstgespräch.
        </p>
        <a href="/kontakt" class="btn btn-primary">
          Jetzt Kontakt aufnehmen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     SECTIONS
     ============================================ */

  .first-section {
    padding-top: 48px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-header .tag-handwritten {
    margin-bottom: 16px;
  }

  .section-header h2 {
    margin-bottom: 12px;
  }

  /* ============================================
     SERVICES LIST
     ============================================ */

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 16px;
    padding: 28px 24px;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .service-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  .service-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.15), rgba(198, 125, 90, 0.05));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-icon svg {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
  }

  .service-title h3 {
    font-size: 1.375rem;
    margin: 0 0 4px 0;
  }

  .service-subtitle {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0;
  }

  .service-body h4 {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .treatment-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .treatment-list li {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding-left: 20px;
    position: relative;
    line-height: 1.5;
  }

  .treatment-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  /* ============================================
     PRICING CARD
     ============================================ */

  .pricing-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 16px;
    overflow: hidden;
    max-width: 540px;
    margin: 0 auto;
  }

  .pricing-header {
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.12), rgba(198, 125, 90, 0.06));
    padding: 24px 28px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .pricing-header h3 {
    font-size: 1.375rem;
    margin: 0;
  }

  .pricing-body {
    padding: 28px;
  }

  .pricing-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .pricing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .pricing-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pricing-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pricing-name {
    font-weight: 600;
    color: var(--color-text);
  }

  .pricing-duration {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .pricing-amount {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .pricing-included {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .pricing-info {
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 20px;
  }

  .pricing-info h4 {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .pricing-info p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .pricing-info p:last-child {
    margin-bottom: 0;
  }

  .pricing-info strong {
    color: var(--color-accent);
    font-weight: 600;
  }

  .pricing-note {
    font-size: 0.875rem;
    font-style: italic;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
  }

  .pricing-link {
    display: block;
    margin-top: 8px;
    font-style: normal;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pricing-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ============================================
     CTA
     ============================================ */

  .cta-section {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .cta-content {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-content .tag-handwritten {
    margin-bottom: 12px;
  }

  .cta-content h2 {
    margin-bottom: 16px;
  }

  .cta-content > p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 32px;
  }

  .cta-content svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 640px) {
    .treatment-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .first-section {
      padding-top: 80px;
    }

    .service-card {
      padding: 36px 40px;
    }

    .info-card {
      padding: 40px;
    }
  }
</style>

<script>
  import { initScrollAnimations } from '../scripts/scroll-animations';
  initScrollAnimations();
</script>

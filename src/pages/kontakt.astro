---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt"
  description="Kontaktieren Sie Susanne Hoppe für einen Termin zur begleitenden osteopathischen Behandlung für Kinder und Familien in Leipzig."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-tag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
          </svg>
          <span>Ich freue mich auf Ihre Nachricht</span>
        </div>
        <h1>Kontakt <span class="accent">aufnehmen</span></h1>
        <p>
          Sie haben Fragen zur osteopathischen Behandlung oder möchten einen Termin vereinbaren?
          Ich bin gerne für Sie und Ihre Familie da.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Info Cards -->
        <div class="contact-info">
          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
                </svg>
              </div>
              <h3>Telefon</h3>
            </div>
            <p class="contact-value">TODO: Telefonnummer</p>
            <p class="contact-note">Am besten telefonisch erreichbar</p>
          </div>

          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </div>
              <h3>E-Mail</h3>
            </div>
            <p class="contact-value">TODO: E-Mail-Adresse</p>
            <p class="contact-note">Oder nutzen Sie das Kontaktformular</p>
          </div>

          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <h3>Einsatzgebiet</h3>
            </div>
            <p class="contact-value">Leipzig und Umgebung</p>
            <p class="contact-note">Ich bespreche gerne, ob Ihr Wohnort im Einsatzgebiet liegt.</p>
          </div>

          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              </div>
              <h3>Hausbesuche</h3>
            </div>
            <p class="contact-value">Alle Behandlungen bei Ihnen zuhause</p>
            <p class="contact-note">Sie benötigen lediglich einen ruhigen Raum.</p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-wrapper">
          <h2>Nachricht senden</h2>

          <form class="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required placeholder="Ihr Name" />
              </div>
              <div class="form-group">
                <label for="email">E-Mail *</label>
                <input type="email" id="email" name="email" required placeholder="ihre.email@beispiel.de" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="phone">Telefon</label>
                <input type="tel" id="phone" name="phone" placeholder="Optional" />
              </div>
              <div class="form-group">
                <label for="child-age">Alter des Kindes</label>
                <input type="text" id="child-age" name="child-age" placeholder="z.B. 3 Monate, 2 Jahre" />
              </div>
            </div>

            <div class="form-group">
              <label for="message">Ihre Nachricht *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Beschreiben Sie kurz Ihr Anliegen. Was sind die Beschwerden? Wann treten sie auf?"
              ></textarea>
            </div>

            <div class="form-checkbox">
              <input type="checkbox" id="privacy" required />
              <label for="privacy">
                Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen
                und bin mit der Verarbeitung meiner Daten einverstanden. *
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-full">
              Nachricht senden
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>

            <p class="form-note">
              * Pflichtfelder – Ich melde mich in der Regel innerhalb von 24 Stunden bei Ihnen zurück.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 64px;
    text-align: center;
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .hero-tag svg {
    width: 18px;
    height: 18px;
  }

  .hero h1 {
    font-size: 2.25rem;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ============================================
     CONTACT GRID
     ============================================ */

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  /* ============================================
     CONTACT INFO
     ============================================ */

  .contact-info {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .contact-card {
    padding: 24px;
  }

  .contact-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }

  .contact-card h3 {
    font-size: 1.125rem;
    margin: 0;
  }

  .contact-value {
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 4px;
  }

  .contact-note {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-style: italic;
    margin: 0;
  }

  /* ============================================
     CONTACT FORM
     ============================================ */

  .contact-form-wrapper {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 16px;
    padding: 32px 24px;
  }

  .contact-form-wrapper h2 {
    font-size: 1.5rem;
    margin-bottom: 28px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 0;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 14px 18px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: all 0.2s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    background: var(--color-bg);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(198, 125, 90, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .form-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 24px 0;
    padding: 16px;
    background: rgba(198, 125, 90, 0.05);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .form-checkbox input[type="checkbox"] {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .form-checkbox label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    cursor: pointer;
  }

  .form-checkbox a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .form-checkbox a:hover {
    text-decoration: underline;
  }

  .btn-full {
    width: 100%;
  }

  .btn-full svg {
    width: 18px;
    height: 18px;
  }

  .form-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 16px;
    font-style: italic;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 640px) {
    .contact-info {
      grid-template-columns: repeat(2, 1fr);
    }

    .form-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding: 80px 0 100px;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .hero p {
      font-size: 1.25rem;
    }

    .contact-form-wrapper {
      padding: 40px;
    }

    .contact-form-wrapper h2 {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero h1 {
      font-size: 3.5rem;
    }

    .contact-grid {
      grid-template-columns: 1fr 1.5fr;
      gap: 48px;
    }

    .contact-info {
      grid-template-columns: 1fr;
    }
  }
</style>

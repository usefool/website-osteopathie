---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt"
  description="Kontaktieren Sie Susanne Hoppe für einen Termin zur begleitenden osteopathischen Behandlung für Kinder und Familien in Leipzig."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <span class="tag-handwritten">Ich freue mich auf Ihre Nachricht</span>
        <h1>Kontakt <span class="accent">aufnehmen</span></h1>
        <p>
          Sie haben Fragen zur osteopathischen Behandlung oder möchten einen Termin vereinbaren?
          Ich bin gerne für Sie und Ihre Familie da.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="contact-content">
        <div class="contact-cards">
          <a href="#" data-contact="email" class="card contact-card contact-card-primary">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              </div>
              <h3>E-Mail</h3>
            </div>
            <p class="contact-value" data-contact="email">...</p>
            <p class="contact-note">Ich antworte in der Regel innerhalb von 24 Stunden</p>
          </a>

          <a href="#" data-contact="phone" class="card contact-card contact-card-secondary">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </div>
              <h3>Telefon</h3>
            </div>
            <p class="contact-value" data-contact="phone">...</p>
            <p class="contact-note">Für schnelle Terminabsprachen</p>
          </a>
        </div>

        <div class="contact-info-cards">
          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <h3>Einsatzgebiet</h3>
            </div>
            <p class="contact-value">Leipzig und Umgebung</p>
            <p class="contact-note">Ich bespreche gerne, ob Ihr Wohnort im Einsatzgebiet liegt.</p>
          </div>

          <div class="card contact-card">
            <div class="contact-card-header">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
              </div>
              <h3>Hausbesuche</h3>
            </div>
            <p class="contact-value">Alle Behandlungen bei Ihnen zuhause</p>
            <p class="contact-note">Sie benötigen lediglich einen ruhigen Raum.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 64px;
    text-align: center;
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-content .tag-handwritten {
    margin-bottom: 16px;
  }

  .hero-content .tag-handwritten::before {
    inset: -8px -40px;
    background-image: url('/brush_long.svg');
  }

  .hero h1 {
    font-size: 2.25rem;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ============================================
     CONTACT CONTENT
     ============================================ */

  .contact-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  .contact-info-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  /* ============================================
     CONTACT CARDS
     ============================================ */

  .contact-card {
    padding: 28px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  a.contact-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(61, 46, 36, 0.12);
  }

  .contact-card-primary {
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.08) 0%, rgba(198, 125, 90, 0.02) 100%);
    border-color: var(--color-accent);
  }

  .contact-card-primary .feature-icon {
    background: var(--color-accent);
  }

  .contact-card-primary .feature-icon svg {
    color: white;
  }

  .contact-card-primary .contact-value {
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .contact-card-secondary .contact-value {
    font-size: 1.125rem;
  }

  .contact-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .contact-card h3 {
    font-size: 1.125rem;
    margin: 0;
    color: var(--color-text);
  }

  .contact-value {
    color: var(--color-text);
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 6px;
  }

  .contact-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 640px) {
    .contact-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-info-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding: 80px 0 100px;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .hero p {
      font-size: 1.25rem;
    }

    .contact-card {
      padding: 32px;
    }

    .contact-card-primary .contact-value {
      font-size: 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .hero h1 {
      font-size: 3.5rem;
    }
  }
</style>

<script>
  import { initContactProtection } from '../scripts/contact-protection';
  initContactProtection();
</script>

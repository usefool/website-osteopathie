---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt"
  description="Kontaktieren Sie Susanne Hoppe für einen Termin zur begleitenden osteopathischen Behandlung für Kinder und Familien in Leipzig."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <span class="tag-handwritten">Ich freue mich auf Sie</span>
        <h1>Kontakt</h1>
        <p>
          Sie haben Fragen oder möchten einen Termin vereinbaren?
          Ich bin gerne für Sie und Ihre Familie da.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Main Contact Options -->
        <div class="contact-main">
          <a href="#" data-contact="email" class="contact-option contact-option-primary">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <div class="contact-details">
              <span class="contact-label">E-Mail</span>
              <span class="contact-value" data-contact="email">...</span>
              <span class="contact-hint">Antwort innerhalb von 24 Stunden</span>
            </div>
            <div class="contact-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>

          <a href="#" data-contact="phone" class="contact-option">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </div>
            <div class="contact-details">
              <span class="contact-label">Telefon</span>
              <span class="contact-value" data-contact="phone">...</span>
              <span class="contact-hint">Auch per WhatsApp und Signal erreichbar</span>
            </div>
            <div class="contact-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        </div>

        <!-- Info Sidebar -->
        <div class="contact-info">
          <div class="info-item">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div class="info-content">
              <h3>Einsatzgebiet</h3>
              <p>Leipzig und Umgebung</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            </div>
            <div class="info-content">
              <h3>Hausbesuche</h3>
              <p>Alle Behandlungen bei Ihnen zuhause</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 32px;
    text-align: center;
  }

  .hero-content {
    max-width: 560px;
    margin: 0 auto;
  }

  .hero-content .tag-handwritten {
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .hero p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ============================================
     CONTACT GRID
     ============================================ */

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
  }

  /* ============================================
     CONTACT OPTIONS (Email & Phone)
     ============================================ */

  .contact-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-option {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .contact-option:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(61, 46, 36, 0.1);
    transform: translateY(-2px);
  }

  .contact-option:hover .contact-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .contact-option-primary {
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.08) 0%, rgba(198, 125, 90, 0.02) 100%);
    border-color: var(--color-accent);
  }

  .contact-option-primary .contact-icon {
    background: var(--color-accent);
  }

  .contact-option-primary .contact-icon svg {
    color: white;
  }

  .contact-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.15), rgba(198, 125, 90, 0.05));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-icon svg {
    width: 26px;
    height: 26px;
    color: var(--color-accent);
  }

  .contact-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .contact-value {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-option-primary .contact-value {
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .contact-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 4px;
  }

  .contact-arrow {
    opacity: 0.4;
    transition: all 0.3s ease;
  }

  .contact-arrow svg {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  /* ============================================
     INFO SIDEBAR
     ============================================ */

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 28px;
    background: var(--color-bg-alt);
    border-radius: 16px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .info-icon {
    width: 40px;
    height: 40px;
    background: var(--color-bg);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-icon svg {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .info-content h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 4px 0;
    color: var(--color-text);
  }

  .info-content p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 768px) {
    .hero {
      padding: 64px 0 40px;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .contact-grid {
      grid-template-columns: 1fr 280px;
      gap: 32px;
      align-items: start;
    }

    .contact-option {
      padding: 28px;
    }

    .contact-info {
      position: sticky;
      top: 100px;
    }
  }

  @media (min-width: 1024px) {
    .hero h1 {
      font-size: 3.25rem;
    }

    .contact-grid {
      grid-template-columns: 1fr 300px;
      gap: 48px;
    }
  }

  /* Very small screens (<400px) */
  @media (max-width: 399px) {
    .hero {
      padding: 32px 0 24px;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero p {
      font-size: 1rem;
    }

    .contact-option {
      padding: 18px;
      gap: 14px;
    }

    .contact-icon {
      width: 48px;
      height: 48px;
    }

    .contact-icon svg {
      width: 22px;
      height: 22px;
    }

    .contact-value {
      font-size: 1rem;
    }

    .contact-option-primary .contact-value {
      font-size: 1.1rem;
    }

    .contact-hint {
      font-size: 0.8rem;
    }

    .contact-info {
      padding: 20px;
    }

    .info-content h3 {
      font-size: 0.9rem;
    }

    .info-content p {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  import { initContactProtection } from '../scripts/contact-protection';
  initContactProtection();
</script>

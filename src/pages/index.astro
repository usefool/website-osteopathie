---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <span class="tag-handwritten">Osteopathie für Neugeborene & Mütter</span>
          <h1><span class="accent">Geborgen Ankommen</span></h1>
          <p class="hero-text">
            Begleitende osteopathische Behandlung für Säuglinge und Mütter in Leipzig.<br />
            Ich komme zu Ihnen nach Hause, damit Sie und Ihr Baby
            in Ruhe ankommen können.
          </p>
          <div class="hero-buttons">
            <a href="/kontakt" class="btn btn-primary">
              Termin anfragen
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
           
          </div>
        </div>
        <div class="photo-pile">
          <div class="photo-pile-item">
            <picture>
              <source srcset="/baby1_new.webp" type="image/webp" />
              <img src="/baby1_new.png" alt="Säugling bei osteopathischer Behandlung" width="400" height="300" />
            </picture>
          </div>
          <div class="photo-pile-item">
            <picture>
              <source srcset="/mother_baby.webp" type="image/webp" />
              <img src="/mother_baby.png" alt="Mutter mit Baby bei Kinderosteopathie" width="400" height="300" />
            </picture>
          </div>
          <div class="photo-pile-item">
            <picture>
              <source srcset="/baby_feet.webp" type="image/webp" />
              <img src="/baby_feet.png" alt="Sanfte Berührung von Baby Füßen" width="400" height="300" />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section about-teaser">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <img
            src="/susanne_new.jpeg"
            alt="Susanne Hoppe – Osteopathin für Neugeborene und Mütter"
            class="about-photo"
          />
        </div>
        <div class="about-content">
          <h2><span class="heading-brush brush-2">Über mich</span></h2>
          <p>
            Ich bin Susanne Hoppe, Physiotherapeutin mit über 20 Jahren Berufserfahrung
            und einer zertifizierten Weiterbildung in Kinderosteopathie. Seit 2016 arbeite
            ich in der Kinderklinik des Universitätsklinikums Leipzig, mit Schwerpunkt auf
            der Neonatologie und Neuropädiatrie.
          </p>
          <p>
            Diese Erfahrung bringe ich zu Ihnen nach Hause: Sanfte, fundierte
            Behandlung für Ihr Baby – in Ihrer vertrauten Umgebung.
          </p>
          <a href="/ueber-mich" class="btn btn-secondary">
            Mehr erfahren
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="tag-handwritten brush-long-2">Ganzheitliche osteopathische Behandlung für Säuglinge und Mütter</span>
        <h2>Meine <span class="accent">Leistungen</span></h2>
      </div>
      <div class="services-grid services-grid-3">
        <div class="card card-split">
          <div class="card-image">
            <picture>
              <source srcset="/baby_feet.webp" type="image/webp" />
              <img src="/baby_feet.png" alt="Sanfte Berührung von Frühgeborenen-Füßen" />
            </picture>
          </div>
          <div class="card-content">
            <h3>Früh- & Neugeborene</h3>
            <p>Behutsame Begleitung der Allerkleinsten – nach Frühgeburt, schwieriger Geburt oder bei Anpassungsproblemen in den ersten Lebenstagen.</p>
          </div>
        </div>
        <div class="card card-split">
          <div class="card-image">
            <picture>
              <source srcset="/baby1_new.webp" type="image/webp" />
              <img src="/baby1_new.png" alt="Säugling bei osteopathischer Behandlung" />
            </picture>
          </div>
          <div class="card-content">
            <h3>Säuglinge</h3>
            <p>Sanfte Behandlung im ersten Lebensjahr – wenn das Ankommen Zeit braucht, die Entwicklung Unterstützung verdient, bei Schlafstörungen oder nach chirurgischen Eingriffen.</p>
          </div>
        </div>
        <div class="card card-split">
          <div class="card-image">
            <picture>
              <source srcset="/mother_baby.webp" type="image/webp" />
              <img src="/mother_baby.png" alt="Mutter mit Baby" />
            </picture>
          </div>
          <div class="card-content">
            <h3>Mütter</h3>
            <p>Behandlung im Wochenbett und darüber hinaus – für Ihre Erholung nach der Geburt und Unterstützung beim Handling.</p>
          </div>
        </div>
      </div>
      <div class="section-cta">
        <a href="/leistungen" class="btn btn-secondary">
          Alle Leistungen ansehen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials Carousel -->
  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header">
        <h2>Das sagen <span class="accent">Eltern</span></h2>
      </div>
      <div class="testimonials-carousel">
        <div class="testimonials-track" id="testimonials-track">
          <div class="testimonial-card">
            <div class="testimonial-quote">
              <svg viewBox="0 0 24 24" fill="currentColor" class="quote-icon">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <p>Wir wollten einfach nur Danke sagen – für alles, was Sie in den letzten Monaten für unsere kleinen Power-Mädels getan haben. Sie haben B. und J. von Anfang an mit so viel Herz, Geduld und Fachwissen begleitet. Dank Ihrer Unterstützung haben die beiden große Fortschritte gemacht – und auch wir haben durch Sie gelernt, wie wir sie im Alltag bestmöglich unterstützen können.</p>
            </div>
            <div class="testimonial-author">
              <span class="author-name">B. & J. und ihre Eltern</span>
              <span class="author-detail">Leipzig-Südvorstadt</span>
            </div>
          </div>
          <div class="testimonial-card">
            <div class="testimonial-quote">
              <svg viewBox="0 0 24 24" fill="currentColor" class="quote-icon">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <p>Liebe Susi, danke für alles! Ohne dich würde ich jetzt nicht nach Hause gehen!</p>
            </div>
            <div class="testimonial-author">
              <span class="author-name">W.</span>
              <span class="author-detail">Leipzig-Lindenau · Frühchen, nach 21 Wochen in der Klinik</span>
            </div>
          </div>
          <div class="testimonial-card">
            <div class="testimonial-quote">
              <svg viewBox="0 0 24 24" fill="currentColor" class="quote-icon">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
              <p>Sie ist eine ganz liebe Seele und hat nicht nur physiotherapeutisch geholfen, sondern war auch seelisch eine Unterstützung und hatte immer ein offenes Ohr. Vielen Dank nochmals dafür!</p>
            </div>
            <div class="testimonial-author">
              <span class="author-name">Y. & C.</span>
              <span class="author-detail">Leipzig-Zentrum</span>
            </div>
          </div>
        </div>
        <div class="carousel-dots" id="carousel-dots"></div>
      </div>
    </div>
  </section>

  <!-- Why Home Visits -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-content">
          <span class="tag-handwritten brush-2">Die Familie im Mittelpunkt</span>
          <h2>Warum <span class="accent">Hausbesuche</span>?</h2>
          <p>
            Kinder fühlen sich zu Hause am wohlsten. Gerade bei den ganz Kleinen
            ist eine geborgene Umgebung wichtig – und wo ist es vertrauter als
            im eigenen Zuhause?
          </p>
          <p>
            Für Sie als Eltern entfällt der Stress mit Packen, Anfahrt und
            Parkplatzsuche. Ergänzend zu meiner osteopathischen Behandlung nutze
            ich die bei Ihnen zu Hause vorhandenen Materialien und zeige Ihnen
            eine individuell auf die Therapie abgestimmte Umfeldgestaltung –
            z.B. für Stillen, Schlafen oder Spielen.
          </p>
        </div>
        <div class="split-image">
          <img
            src="/bild_hausbesuch.png"
            alt="Osteopathische Behandlung eines Säuglings im häuslichen Umfeld"
            class="split-photo"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Bereit für einen <span class="accent">Termin</span>?</h2>
        <p>Kontaktieren Sie mich für ein unverbindliches Erstgespräch oder eine Terminvereinbarung.</p>
        <div class="cta-buttons">
          <a href="/kontakt" class="btn btn-primary">
            Jetzt Kontakt aufnehmen
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#" data-contact="phone" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Anrufen
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 64px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/hero_abstract2.webp');
    background-size: cover;
    background-position: center top;
    opacity: 0.12;
    filter: saturate(0.4);
    z-index: -1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    max-width: 640px;
  }

  /* Photo Pile */
  .photo-pile {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
  }

  .photo-pile-item {
    width: 160px;
    height: 200px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(61, 46, 36, 0.15), 0 4px 8px rgba(61, 46, 36, 0.1);
    background: var(--color-bg-alt);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .photo-pile-item:nth-child(1) {
    transform: rotate(-6deg) translateY(15px);
    margin-right: -30px;
    z-index: 1;
  }

  .photo-pile-item:nth-child(1):hover {
    transform: rotate(-3deg) translateY(10px) scale(1.02);
    z-index: 10;
  }

  .photo-pile-item:nth-child(2) {
    transform: rotate(-1deg);
    z-index: 3;
  }

  .photo-pile-item:nth-child(2):hover {
    transform: rotate(0deg) scale(1.02);
    z-index: 10;
  }

  .photo-pile-item:nth-child(3) {
    transform: rotate(5deg) translateY(20px);
    margin-left: -30px;
    z-index: 2;
  }

  .photo-pile-item:nth-child(3):hover {
    transform: rotate(2deg) translateY(15px) scale(1.02);
    z-index: 10;
  }

  .photo-pile-item:hover {
    box-shadow: 0 20px 40px rgba(61, 46, 36, 0.2), 0 8px 16px rgba(61, 46, 36, 0.12);
  }

  .photo-pile-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) contrast(0.95) brightness(1.05);
  }

  .hero .tag-handwritten {
    margin-bottom: 20px;
  }

  .hero h1 {
    font-size: 2.25rem;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-buttons svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     ABOUT TEASER
     ============================================ */

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .about-image .image-placeholder {
    aspect-ratio: 1;
    max-width: 280px;
    margin: 0 auto;
    border-radius: 50%;
  }

  .about-photo {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: left top;
    border-radius: 16px;
    margin: 0 auto;
    display: block;
    box-shadow: 0 8px 24px rgba(61, 46, 36, 0.12);
    transform: rotate(-2deg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .about-photo:hover {
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0 12px 32px rgba(61, 46, 36, 0.18);
  }

  .about-content h2 {
    margin-bottom: 20px;
  }

  .about-content p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .about-content .btn {
    margin-top: 8px;
  }

  .about-content .btn svg {
    width: 18px;
    height: 18px;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 320px 1fr;
      gap: 56px;
    }

    .about-image .image-placeholder {
      margin: 0;
    }

    .about-photo {
      margin: 0;
    }
  }

  /* ============================================
     SECTIONS
     ============================================ */

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-header .tag-handwritten {
    margin-bottom: 16px;
  }

  .section-header .tag-handwritten::before {
    inset: -8px -60px;
  }

  .section-header h2 {
    margin-bottom: 12px;
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .section-cta {
    text-align: center;
    margin-top: 40px;
  }

  .section-cta svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     SERVICES GRID
     ============================================ */

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .services-grid-2 {
    max-width: 900px;
    margin: 0 auto;
  }

  .services-grid-3 {
    max-width: 1100px;
    margin: 0 auto;
  }

  .card-split {
    display: grid;
    grid-template-columns: 25% 1fr;
    gap: 0;
    align-items: stretch;
    text-align: left;
    padding: 0;
    overflow: hidden;
  }

  .card-split .card-image {
    min-height: 160px;
    overflow: hidden;
  }

  .card-split .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) contrast(0.95) brightness(1.05);
  }

  .services-grid-3 .card-split:first-child .card-image img {
    object-position: calc(50% - 30px) center;
  }

  .card-split .card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-split .card-content h3 {
    margin: 0 0 10px 0;
    font-size: 1.1rem;
  }

  .card-split .card-content p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .services-grid .card {
    transition: all 0.3s ease;
    position: relative;
  }

  .services-grid .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(198, 125, 90, 0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .services-grid .card:hover::before {
    opacity: 1;
  }

  .services-grid .card:hover {
    transform: translateY(-2px);
  }

  .services-grid .card:hover .feature-icon {
    transform: scale(1.05);
  }

  .services-grid .card .feature-icon {
    transition: transform 0.3s ease;
  }

  .services-grid .card h3 {
    margin: 20px 0 12px;
    font-size: 1.25rem;
  }

  .services-grid .card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     TESTIMONIALS CAROUSEL
     ============================================ */

  .testimonials-section {
    overflow: hidden;
    position: relative;
  }

  .testimonials-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/hero_abstract2.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    filter: saturate(0.4);
    z-index: -1;
  }

  .testimonials-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .testimonials-track {
    display: flex;
    gap: 24px;
    transition: transform 0.6s ease-in-out;
  }

  .testimonial-card {
    flex-shrink: 0;
    width: calc((100% - 48px) / 3);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .testimonial-quote {
    position: relative;
  }

  .quote-icon {
    width: 32px;
    height: 32px;
    color: var(--color-accent);
    opacity: 0.3;
    margin-bottom: 12px;
  }

  .testimonial-quote p {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    margin: 0;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .author-detail {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .carousel-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .carousel-dot:hover {
    background: var(--color-accent);
    opacity: 0.6;
  }

  .carousel-dot.active {
    background: var(--color-accent);
    transform: scale(1.2);
  }

  /* Mobile: show 1 card */
  @media (max-width: 640px) {
    .testimonial-card {
      width: 100%;
      padding: 24px;
    }
  }

  /* Tablet: show 2 cards */
  @media (min-width: 641px) and (max-width: 1023px) {
    .testimonial-card {
      width: calc((100% - 24px) / 2);
    }
  }

  /* ============================================
     SPLIT SECTION (Why Home Visits)
     ============================================ */

  .split-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .split-content .tag-handwritten {
    margin-bottom: 12px;
  }

  .split-content h2 {
    margin-bottom: 16px;
  }

  .split-content > p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    color: var(--color-text);
  }

  .check-list svg {
    width: 22px;
    height: 22px;
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .image-placeholder {
    background: var(--color-bg-alt);
    border: 2px dashed var(--color-border);
    border-radius: 16px;
    aspect-ratio: 4/3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--color-text-muted);
  }

  .image-placeholder svg {
    width: 48px;
    height: 48px;

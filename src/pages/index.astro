---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-tag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Mobile Kinderosteopathie Leipzig</span>
        </div>
        <h1>Sanfte Hände für <span class="accent">kleine Patienten</span></h1>
        <p class="hero-text">
          Ich komme zu Ihnen nach Hause – für eine entspannte osteopathische
          Behandlung Ihres Kindes in vertrauter Umgebung.
        </p>
        <div class="hero-buttons">
          <a href="/kontakt" class="btn btn-primary">
            Termin anfragen
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/leistungen" class="btn btn-secondary">Mehr erfahren</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Meine <span class="accent">Leistungen</span></h2>
        <p>Ganzheitliche osteopathische Behandlung für Kinder jeden Alters</p>
      </div>
      <div class="services-grid">
        <div class="card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3>Säuglinge</h3>
          <p>Sanfte Behandlung bei Schreibabys, Stillproblemen, Asymmetrien und Verdauungsbeschwerden.</p>
        </div>
        <div class="card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m9 5.197v1" />
            </svg>
          </div>
          <h3>Kleinkinder</h3>
          <p>Unterstützung bei motorischen Entwicklungsverzögerungen, Haltungsproblemen und wiederkehrenden Infekten.</p>
        </div>
        <div class="card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 14l9-5-9-5-9 5 9 5zm0 7l-9-5 9 5 9-5-9 5z" />
            </svg>
          </div>
          <h3>Schulkinder</h3>
          <p>Hilfe bei Konzentrationsschwierigkeiten, Kopfschmerzen, Rückenproblemen und Schulstress.</p>
        </div>
      </div>
      <div class="section-cta">
        <a href="/leistungen" class="btn btn-secondary">
          Alle Leistungen ansehen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Home Visits -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-content">
          <h2>Warum <span class="accent">Hausbesuche</span>?</h2>
          <p>
            Kinder fühlen sich in ihrer gewohnten Umgebung am wohlsten.
            Durch meinen mobilen Service entfällt der Stress der Anfahrt,
            und Ihr Kind kann sich vollkommen entspannen.
          </p>
          <ul class="check-list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Behandlung in vertrauter Umgebung</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Kein Anfahrtsstress für die Familie</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Flexible Termingestaltung</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Individuelle Betreuung</span>
            </li>
          </ul>
        </div>
        <div class="split-image">
          <div class="image-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Bild folgt</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Mein <span class="accent">Ansatz</span></h2>
        <p>Ganzheitlich, sanft und auf die Bedürfnisse Ihres Kindes abgestimmt</p>
      </div>
      <div class="approach-grid">
        <div class="approach-item">
          <div class="approach-number">01</div>
          <h3>Ausführliche Anamnese</h3>
          <p>Im ersten Gespräch nehme ich mir Zeit, die Geschichte Ihres Kindes zu verstehen.</p>
        </div>
        <div class="approach-item">
          <div class="approach-number">02</div>
          <h3>Sanfte Untersuchung</h3>
          <p>Mit feinfühligen Händen ertaste ich Spannungen und Bewegungseinschränkungen.</p>
        </div>
        <div class="approach-item">
          <div class="approach-number">03</div>
          <h3>Individuelle Behandlung</h3>
          <p>Die Therapie wird auf die Bedürfnisse Ihres Kindes abgestimmt.</p>
        </div>
        <div class="approach-item">
          <div class="approach-number">04</div>
          <h3>Nachsorge & Beratung</h3>
          <p>Sie erhalten Tipps und Übungen für den Alltag mit Ihrem Kind.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Bereit für einen <span class="accent">Termin</span>?</h2>
        <p>Kontaktieren Sie mich für ein unverbindliches Erstgespräch oder eine Terminvereinbarung.</p>
        <div class="cta-buttons">
          <a href="/kontakt" class="btn btn-primary">
            Jetzt Kontakt aufnehmen
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:TODO" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Anrufen
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */

  .hero {
    padding: 48px 0 64px;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .hero-tag svg {
    width: 18px;
    height: 18px;
  }

  .hero h1 {
    font-size: 2.25rem;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-buttons svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     SECTIONS
     ============================================ */

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-header h2 {
    margin-bottom: 12px;
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .section-cta {
    text-align: center;
    margin-top: 40px;
  }

  .section-cta svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     SERVICES GRID
     ============================================ */

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .services-grid .card h3 {
    margin: 20px 0 12px;
    font-size: 1.25rem;
  }

  .services-grid .card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     SPLIT SECTION (Why Home Visits)
     ============================================ */

  .split-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .split-content h2 {
    margin-bottom: 16px;
  }

  .split-content > p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    color: var(--color-text);
  }

  .check-list svg {
    width: 22px;
    height: 22px;
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .image-placeholder {
    background: var(--color-bg-alt);
    border: 2px dashed var(--color-border);
    border-radius: 16px;
    aspect-ratio: 4/3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--color-text-muted);
  }

  .image-placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  .image-placeholder span {
    font-size: 0.875rem;
  }

  /* ============================================
     APPROACH
     ============================================ */

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .approach-item {
    text-align: center;
  }

  .approach-number {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-accent);
    opacity: 0.4;
    margin-bottom: 12px;
  }

  .approach-item h3 {
    font-size: 1.125rem;
    margin-bottom: 8px;
  }

  .approach-item p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     CTA SECTION
     ============================================ */

  .cta-section {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .cta-content {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: 16px;
  }

  .cta-content > p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 32px;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .cta-buttons svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding: 80px 0 100px;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .hero-text {
      font-size: 1.25rem;
    }

    .split-section {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  @media (min-width: 1024px) {
    .hero h1 {
      font-size: 3.5rem;
    }

    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .approach-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

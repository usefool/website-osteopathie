---
/**
 * Design-Varianten Archiv
 * T1-T18: Typografie-Varianten
 * V1-V24: Original Design-Varianten
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Design-Archiv | Susanne Hoppe Projekt</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-gold: #c9a962;
      --color-navy: #0a1628;
      --color-navy-light: #132238;
      --color-cream: #f9f7f3;
      --font-sans: 'Inter', -apple-system, sans-serif;
      --font-serif: 'Newsreader', Georgia, serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-cream);
      background: var(--color-navy);
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header */
    .header {
      padding: 32px 0;
      border-bottom: 1px solid rgba(201, 169, 98, 0.15);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .back-link {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--color-gold);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: gap 0.2s;
    }

    .back-link:hover { gap: 12px; }

    .back-link svg {
      width: 20px;
      height: 20px;
    }

    .current-link {
      color: rgba(249, 247, 243, 0.5);
      text-decoration: none;
      font-size: 0.875rem;
      transition: color 0.2s;
    }

    .current-link:hover {
      color: var(--color-cream);
    }

    /* Hero */
    .hero {
      padding: 60px 0;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(249, 247, 243, 0.05);
      border: 1px solid rgba(249, 247, 243, 0.1);
      color: rgba(249, 247, 243, 0.6);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: 2.5rem;
      font-weight: 500;
      color: var(--color-cream);
      margin-bottom: 12px;
    }

    .hero .lead {
      font-size: 1rem;
      color: rgba(249, 247, 243, 0.6);
      max-width: 500px;
      margin: 0 auto;
    }

    /* Grid */
    .archive-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
      padding: 60px 0;
    }

    .archive-card {
      background: var(--color-navy-light);
      border: 1px solid rgba(201, 169, 98, 0.1);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      transition: all 0.2s;
    }

    .archive-card:hover {
      border-color: var(--color-gold);
      transform: translateY(-4px);
    }

    .archive-card.selected {
      border-color: var(--color-gold);
      border-width: 2px;
    }

    .card-preview {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 600;
    }

    .card-info {
      padding: 12px;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
      text-align: center;
    }

    .card-name {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-cream);
    }

    .card-badge {
      display: inline-block;
      background: var(--color-gold);
      color: var(--color-navy);
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.65rem;
      font-weight: 600;
      margin-top: 6px;
    }

    /* Section Headers */
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-top: 40px;
    }

    .section-header h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(249, 247, 243, 0.6);
    }

    .section-count {
      background: rgba(201, 169, 98, 0.2);
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 0.7rem;
      color: var(--color-gold);
    }

    /* T-Variant Cards with Palette */
    .t-card-fonts {
      font-size: 0.65rem;
      color: var(--color-gold);
      margin-top: 4px;
    }

    .t-card-palette {
      display: flex;
      gap: 4px;
      margin-top: 8px;
    }

    .palette-swatch {
      flex: 1;
      height: 16px;
      border-radius: 3px;
      border: 1px solid rgba(255,255,255,0.1);
    }

    /* Footer */
    .footer {
      padding: 48px 0;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
      text-align: center;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 32px;
    }

    .footer-links a {
      color: rgba(249, 247, 243, 0.5);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--color-gold);
    }

    @media (max-width: 1024px) {
      .archive-grid { grid-template-columns: repeat(4, 1fr); }
    }

    @media (max-width: 768px) {
      .archive-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 480px) {
      .archive-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>

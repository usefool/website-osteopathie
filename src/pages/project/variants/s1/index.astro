---
/**
 * S1 - Playfair Display + DM Sans
 * Elegant Classic Serif Typography
 * Base: V24 Dark Luxury
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S1: Playfair Display | Typografie-Variante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-gold: #c9a962;
      --color-navy: #0a1628;
      --color-navy-light: #132238;
      --color-cream: #f9f7f3;
      --font-sans: 'DM Sans', -apple-system, sans-serif;
      --font-serif: 'Playfair Display', Georgia, serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-cream);
      background: var(--color-navy);
      line-height: 1.6;
    }

    .variant-tag {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--color-gold);
      color: var(--color-navy);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 600;
      z-index: 100;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header */
    .header {
      padding: 32px 0;
      border-bottom: 1px solid rgba(201, 169, 98, 0.15);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-icon {
      width: 44px;
      height: 44px;
      background: var(--color-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-navy);
      font-family: var(--font-serif);
      font-weight: 500;
      font-size: 1.25rem;
      font-style: italic;
    }

    .logo-text {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--color-cream);
    }

    .nav {
      display: flex;
      gap: 32px;
    }

    .nav a {
      color: rgba(249, 247, 243, 0.6);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav a:hover, .nav a.active {
      color: var(--color-cream);
    }

    /* Hero */
    .hero {
      padding: 120px 0 100px;
      text-align: center;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(201, 169, 98, 0.1);
      border: 1px solid rgba(201, 169, 98, 0.2);
      color: var(--color-gold);
      padding: 10px 20px;
      border-radius: 30px;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 32px;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: 4rem;
      font-weight: 400;
      line-height: 1.1;
      color: var(--color-cream);
      margin-bottom: 28px;
      letter-spacing: -0.01em;
    }

    .hero h1 em {
      color: var(--color-gold);
      font-style: italic;
    }

    .hero .lead {
      font-size: 1.25rem;
      color: rgba(249, 247, 243, 0.7);
      line-height: 1.7;
      max-width: 600px;
      margin: 0 auto 40px;
      font-weight: 400;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 32px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      border-radius: 30px;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--color-gold);
      color: var(--color-navy);
    }

    .btn-primary:hover {
      background: #d4b56e;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(201, 169, 98, 0.3);
    }

    /* Features */
    .features {
      padding: 100px 0;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    .feature-card {
      background: var(--color-navy-light);
      border: 1px solid rgba(201, 169, 98, 0.1);
      border-radius: 16px;
      padding: 40px 32px;
      text-align: center;
      transition: all 0.3s;
    }

    .feature-card:hover {
      border-color: rgba(201, 169, 98, 0.3);
      transform: translateY(-4px);
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      background: rgba(201, 169, 98, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
    }

    .feature-icon svg {
      width: 28px;
      height: 28px;
      stroke: var(--color-gold);
    }

    .feature-card h3 {
      font-family: var(--font-serif);
      font-size: 1.375rem;
      font-weight: 500;
      color: var(--color-cream);
      margin-bottom: 12px;
    }

    .feature-card p {
      color: rgba(249, 247, 243, 0.65);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Typography Info */
    .typo-info {
      padding: 60px 0;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
      text-align: center;
    }

    .typo-info h2 {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      color: var(--color-gold);
      margin-bottom: 24px;
    }

    .font-sample {
      display: flex;
      justify-content: center;
      gap: 60px;
      margin-top: 32px;
    }

    .font-sample div {
      text-align: left;
    }

    .font-sample h4 {
      font-size: 0.75rem;
      color: rgba(249, 247, 243, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 8px;
    }

    .sample-serif {
      font-family: var(--font-serif);
      font-size: 2rem;
      color: var(--color-cream);
    }

    .sample-sans {
      font-family: var(--font-sans);
      font-size: 1.5rem;
      color: var(--color-cream);
    }

    @media (max-width: 768px) {
      .nav { display: none; }
      .hero h1 { font-size: 2.5rem; }
      .features-grid { grid-template-columns: 1fr; }
      .font-sample { flex-direction: column; gap: 32px; align-items: center; }
    }
  </style>
</head>
<body>
  <div class="variant-tag">S1: Playfair Display</div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <div class="logo-icon">S</div>
          <span class="logo-text">Susanne Hoppe</span>
        </a>
        <nav class="nav">
          <a href="#" class="active">Home</a>
          <a href="#">Über mich</a>
          <a href="#">Leistungen</a>
          <a href="#">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-tag">Mobile Kinderosteopathie Leipzig</div>
      <h1>Sanfte <em>Osteopathie</em><br>für Ihr Kind</h1>
      <p class="lead">
        Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien –
        einfühlsam und bei Ihnen zuhause.
      </p>
      <a href="#" class="btn btn-primary">Termin anfragen</a>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <h3>Bei Ihnen zuhause</h3>
          <p>Entspannte Behandlung in vertrauter Umgebung für Ihr Kind.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5"/>
            </svg>
          </div>
          <h3>Klinische Erfahrung</h3>
          <p>Tätig auf einer Neugeborenenstation mit medizinischer Expertise.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Für die Familie</h3>
          <p>Ganzheitliche Begleitung für Kinder und ihre Familien.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="typo-info">
    <div class="container">
      <h2>Typografie dieser Variante</h2>
      <div class="font-sample">
        <div>
          <h4>Serif (Headlines)</h4>
          <p class="sample-serif">Playfair Display</p>
        </div>
        <div>
          <h4>Sans-Serif (Body)</h4>
          <p class="sample-sans">DM Sans</p>
        </div>
      </div>
    </div>
  </section>
</body>
</html>

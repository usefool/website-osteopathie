---
/**
 * S11 - Frosted Glass
 * Glassmorphism + Cool Silver + subtle Rose accent
 * Base: S2 Cool Silver
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S11: Frosted Glass | Typografie-Variante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Cool silver palette */
      --color-silver: #a8b4c4;
      --color-silver-light: #c8d4e4;
      --color-platinum: #e8ecf0;
      --color-navy-cool: #0a0e14;
      --color-navy-slate: #141a24;
      --color-ice: #f4f6f8;
      /* Subtle secondary accent - soft rose, used MINIMALLY */
      --color-rose: #d4a5a5;
      --font-sans: 'Inter', -apple-system, sans-serif;
      --font-serif: 'Newsreader', Georgia, serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-ice);
      background: var(--color-navy-cool);
      line-height: 1.6;
      min-height: 100vh;
      position: relative;
    }

    /* Subtle gradient mesh background */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 20%, rgba(168, 180, 196, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(212, 165, 165, 0.04) 0%, transparent 50%),
        radial-gradient(ellipse at 60% 40%, rgba(200, 212, 228, 0.06) 0%, transparent 40%);
      pointer-events: none;
      z-index: 0;
    }

    .variant-tag {
      position: fixed;
      top: 20px;
      right: 20px;
      background: rgba(168, 180, 196, 0.15);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(168, 180, 196, 0.2);
      color: var(--color-ice);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 600;
      z-index: 100;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    /* Header - Glass */
    .header {
      padding: 24px 0;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(20, 26, 36, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(168, 180, 196, 0.1);
      border-radius: 16px;
      padding: 12px 24px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      background: rgba(168, 180, 196, 0.15);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(168, 180, 196, 0.2);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-ice);
      font-weight: 600;
      font-size: 1rem;
    }

    .logo-text {
      font-weight: 500;
      font-size: 1.05rem;
      color: var(--color-ice);
    }

    .nav {
      display: flex;
      gap: 8px;
    }

    .nav a {
      color: rgba(244, 246, 248, 0.5);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .nav a:hover {
      color: var(--color-ice);
      background: rgba(168, 180, 196, 0.1);
    }

    .nav a.active {
      color: var(--color-ice);
      background: rgba(168, 180, 196, 0.15);
    }

    /* Hero */
    .hero {
      padding: 100px 0 80px;
      position: relative;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .hero-text h1 {
      font-family: var(--font-serif);
      font-size: 3.25rem;
      font-weight: 500;
      line-height: 1.15;
      color: var(--color-ice);
      margin-bottom: 24px;
    }

    .hero-text h1 .accent {
      color: var(--color-silver-light);
    }

    .hero-text .lead {
      font-size: 1.1rem;
      color: rgba(244, 246, 248, 0.55);
      line-height: 1.75;
      margin-bottom: 36px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 28px;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      border-radius: 12px;
      transition: all 0.3s;
    }

    .btn-primary {
      background: rgba(168, 180, 196, 0.2);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(168, 180, 196, 0.3);
      color: var(--color-ice);
    }

    .btn-primary:hover {
      background: rgba(168, 180, 196, 0.3);
      border-color: rgba(168, 180, 196, 0.5);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .visual-card {
      width: 300px;
      height: 380px;
      background: rgba(20, 26, 36, 0.4);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(168, 180, 196, 0.15);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .visual-card::before {
      content: "";
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        135deg,
        rgba(168, 180, 196, 0.1) 0%,
        transparent 50%
      );
      pointer-events: none;
    }

    /* Subtle rose glow - MINIMAL use */
    .visual-card::after {
      content: "";
      position: absolute;
      bottom: -20%;
      right: -20%;
      width: 60%;
      height: 60%;
      background: radial-gradient(circle, rgba(212, 165, 165, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .visual-icon {
      width: 80px;
      height: 80px;
      background: rgba(168, 180, 196, 0.1);
      border: 1px solid rgba(168, 180, 196, 0.2);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }

    .visual-icon svg {
      width: 36px;
      height: 36px;
      stroke: var(--color-silver);
    }

    .visual-text {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      color: rgba(244, 246, 248, 0.7);
      text-align: center;
      line-height: 1.6;
      font-style: italic;
      position: relative;
      z-index: 1;
    }

    .visual-label {
      position: absolute;
      bottom: 24px;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: rgba(168, 180, 196, 0.5);
    }

    /* Features - Glass Cards */
    .features {
      padding: 80px 0;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .feature-card {
      background: rgba(20, 26, 36, 0.5);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(168, 180, 196, 0.1);
      border-radius: 20px;
      padding: 36px 28px;
      text-align: center;
      transition: all 0.3s;
    }

    .feature-card:hover {
      background: rgba(20, 26, 36, 0.6);
      border-color: rgba(168, 180, 196, 0.2);
      transform: translateY(-4px);
    }

    .feature-icon {
      width: 54px;
      height: 54px;
      background: rgba(168, 180, 196, 0.1);
      border: 1px solid rgba(168, 180, 196, 0.15);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .feature-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--color-silver);
    }

    .feature-card h3 {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--color-ice);
      margin-bottom: 10px;
    }

    .feature-card p {
      color: rgba(244, 246, 248, 0.5);
      font-size: 0.875rem;
      line-height: 1.6;
    }

    /* Color Info */
    .color-info {
      padding: 80px 0;
      text-align: center;
    }

    .color-info h2 {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      color: var(--color-silver);
      margin-bottom: 40px;
      font-style: italic;
    }

    .color-palette {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .palette-item {
      text-align: center;
      background: rgba(20, 26, 36, 0.4);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(168, 180, 196, 0.1);
      border-radius: 16px;
      padding: 20px 16px;
      min-width: 100px;
    }

    .palette-swatch {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      margin: 0 auto 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .palette-name {
      font-size: 0.7rem;
      color: rgba(244, 246, 248, 0.5);
      margin-bottom: 4px;
    }

    .palette-hex {
      font-size: 0.65rem;
      color: var(--color-silver);
      font-family: monospace;
    }

    /* Rose accent indicator */
    .palette-item.accent-secondary .palette-swatch {
      box-shadow: 0 0 20px rgba(212, 165, 165, 0.3);
    }

    @media (max-width: 1024px) {
      .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-visual { display: none; }
    }

    @media (max-width: 768px) {
      .nav { display: none; }
      .header-inner { padding: 12px 16px; }
      .hero-text h1 { font-size: 2.5rem; }
      .features-grid { grid-template-columns: 1fr; }
      .color-palette { gap: 12px; }
      .palette-item { min-width: 80px; padding: 16px 12px; }
    }
  </style>
</head>
<body>
  <div class="variant-tag">S11: Frosted Glass</div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <div class="logo-icon">SH</div>
          <span class="logo-text">Susanne Hoppe</span>
        </a>
        <nav class="nav">
          <a href="#" class="active">Home</a>
          <a href="#">Über mich</a>
          <a href="#">Leistungen</a>
          <a href="#">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Sanfte <span class="accent">Osteopathie</span> für Ihr Kind</h1>
          <p class="lead">
            Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien –
            einfühlsam und bei Ihnen zuhause in Leipzig.
          </p>
          <a href="#" class="btn btn-primary">Termin anfragen</a>
        </div>
        <div class="hero-visual">
          <div class="visual-card">
            <div class="visual-icon">
              <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <div class="visual-text">
              Mobile<br>Kinderosteopathie<br>Leipzig
            </div>
            <span class="visual-label">Hausbesuche</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <h3>Bei Ihnen zuhause</h3>
          <p>Entspannte Behandlung in vertrauter Umgebung für Ihr Kind.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5"/>
            </svg>
          </div>
          <h3>Klinische Erfahrung</h3>
          <p>Tätig auf einer Neugeborenenstation mit medizinischer Expertise.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <h3>Für die Familie</h3>
          <p>Ganzheitliche Begleitung für Kinder und ihre Familien.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="color-info">
    <div class="container">
      <h2>Glassmorphism & Farben</h2>
      <div class="color-palette">
        <div class="palette-item">
          <div class="palette-swatch" style="background: rgba(20, 26, 36, 0.6); backdrop-filter: blur(8px);"></div>
          <div class="palette-name">Glass Dark</div>
          <div class="palette-hex">rgba()</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #a8b4c4;"></div>
          <div class="palette-name">Silver</div>
          <div class="palette-hex">#a8b4c4</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #c8d4e4;"></div>
          <div class="palette-name">Silver Light</div>
          <div class="palette-hex">#c8d4e4</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #0a0e14;"></div>
          <div class="palette-name">Navy Cool</div>
          <div class="palette-hex">#0a0e14</div>
        </div>
        <div class="palette-item accent-secondary">
          <div class="palette-swatch" style="background: #d4a5a5;"></div>
          <div class="palette-name">Rose (Akzent)</div>
          <div class="palette-hex">#d4a5a5</div>
        </div>
      </div>
    </div>
  </section>
</body>
</html>

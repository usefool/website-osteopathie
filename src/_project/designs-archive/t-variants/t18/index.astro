---
/**
 * T18 - Space Grotesk
 * Technical Modern Sans-Serif
 * Cool Silver palette
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>T18: Space Grotesk | Typografie-Variante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-silver: #c8d4e4;
      --color-silver-bright: #dae3f0;
      --color-navy: #0a0e14;
      --color-navy-light: #121820;
      --color-ice: #f4f6f8;
      --font-sans: 'Space Grotesk', -apple-system, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-ice);
      background: var(--color-navy);
      line-height: 1.6;
    }

    .variant-tag {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--color-silver);
      color: var(--color-navy);
      padding: 8px 16px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      z-index: 100;
      letter-spacing: 0.02em;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .header {
      padding: 28px 0;
      border-bottom: 1px solid rgba(200, 212, 228, 0.1);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      background: var(--color-silver);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-navy);
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.02em;
    }

    .logo-text {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--color-ice);
      letter-spacing: 0.01em;
    }

    .nav {
      display: flex;
      gap: 28px;
    }

    .nav a {
      color: rgba(244, 246, 248, 0.5);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      transition: color 0.2s;
    }

    .nav a:hover { color: var(--color-ice); }
    .nav a.active { color: var(--color-silver); }

    .hero {
      padding: 120px 0 100px;
      text-align: center;
      position: relative;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: 20%;
      left: 50%;
      transform: translateX(-50%);
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(200, 212, 228, 0.04), transparent 70%);
      pointer-events: none;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(200, 212, 228, 0.08);
      border: 1px solid rgba(200, 212, 228, 0.15);
      color: var(--color-silver);
      padding: 10px 20px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 36px;
    }

    .hero h1 {
      font-size: 3.75rem;
      font-weight: 700;
      line-height: 1.08;
      color: var(--color-ice);
      margin-bottom: 24px;
      letter-spacing: -0.02em;
    }

    .hero h1 span {
      color: var(--color-silver);
    }

    .hero .lead {
      font-size: 1.1rem;
      color: rgba(244, 246, 248, 0.65);
      line-height: 1.75;
      max-width: 540px;
      margin: 0 auto 44px;
      font-weight: 400;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 32px;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      border-radius: 4px;
      transition: all 0.2s;
      letter-spacing: 0.02em;
    }

    .btn-primary {
      background: var(--color-silver);
      color: var(--color-navy);
    }

    .btn-primary:hover {
      background: var(--color-silver-bright);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(200, 212, 228, 0.2);
    }

    .features {
      padding: 100px 0;
      background: var(--color-navy-light);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      background: var(--color-navy);
      border: 1px solid rgba(200, 212, 228, 0.08);
      border-radius: 8px;
      padding: 36px 28px;
      text-align: center;
      transition: all 0.3s;
    }

    .feature-card:hover {
      border-color: rgba(200, 212, 228, 0.25);
      transform: translateY(-4px);
    }

    .feature-icon {
      width: 50px;
      height: 50px;
      background: rgba(200, 212, 228, 0.08);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .feature-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--color-silver);
    }

    .feature-card h3 {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--color-ice);
      margin-bottom: 10px;
      letter-spacing: 0.01em;
    }

    .feature-card p {
      color: rgba(244, 246, 248, 0.6);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .typo-info {
      padding: 80px 0;
      text-align: center;
      border-top: 1px solid rgba(200, 212, 228, 0.08);
    }

    .typo-info h2 {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--color-silver);
      margin-bottom: 40px;
      letter-spacing: 0.02em;
    }

    .font-sample {
      display: flex;
      justify-content: center;
      gap: 70px;
    }

    .font-sample div { text-align: left; }

    .font-sample h4 {
      font-size: 0.7rem;
      color: rgba(244, 246, 248, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 8px;
    }

    .sample-headline {
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-ice);
      letter-spacing: -0.01em;
    }

    .sample-body {
      font-size: 1.25rem;
      font-weight: 400;
      color: var(--color-ice);
    }

    .color-palette {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 48px;
    }

    .palette-item { text-align: center; }

    .palette-swatch {
      width: 56px;
      height: 56px;
      border-radius: 6px;
      margin-bottom: 8px;
      border: 2px solid rgba(244, 246, 248, 0.1);
    }

    .palette-name {
      font-size: 0.65rem;
      color: rgba(244, 246, 248, 0.5);
      margin-bottom: 2px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .palette-hex {
      font-size: 0.65rem;
      color: var(--color-silver);
      font-family: monospace;
    }

    @media (max-width: 768px) {
      .nav { display: none; }
      .hero h1 { font-size: 2.5rem; }
      .features-grid { grid-template-columns: 1fr; }
      .font-sample { flex-direction: column; gap: 32px; align-items: center; }
    }
  </style>
</head>
<body>
  <div class="variant-tag">T18: Space Grotesk</div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <div class="logo-icon">SH</div>
          <span class="logo-text">Susanne Hoppe</span>
        </a>
        <nav class="nav">
          <a href="#" class="active">Home</a>
          <a href="#">Über mich</a>
          <a href="#">Leistungen</a>
          <a href="#">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-tag">Mobile Kinderosteopathie Leipzig</div>
      <h1>Sanfte <span>Osteopathie</span><br>für Ihr Kind</h1>
      <p class="lead">
        Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien –
        einfühlsam und bei Ihnen zuhause.
      </p>
      <a href="#" class="btn btn-primary">Termin anfragen</a>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <h3>Bei Ihnen zuhause</h3>
          <p>Entspannte Behandlung in vertrauter Umgebung für Ihr Kind.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5"/>
            </svg>
          </div>
          <h3>Klinische Erfahrung</h3>
          <p>Tätig auf einer Neugeborenenstation mit medizinischer Expertise.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <h3>Für die Familie</h3>
          <p>Ganzheitliche Begleitung für Kinder und ihre Familien.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="typo-info">
    <div class="container">
      <h2>Typografie & Farben dieser Variante</h2>
      <div class="font-sample">
        <div>
          <h4>Headlines</h4>
          <p class="sample-headline">Space Grotesk 700</p>
        </div>
        <div>
          <h4>Body</h4>
          <p class="sample-body">Space Grotesk 400</p>
        </div>
      </div>
      <div class="color-palette">
        <div class="palette-item">
          <div class="palette-swatch" style="background: #0a0e14;"></div>
          <div class="palette-name">Cool Navy</div>
          <div class="palette-hex">#0a0e14</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #c8d4e4;"></div>
          <div class="palette-name">Silver</div>
          <div class="palette-hex">#c8d4e4</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #f4f6f8;"></div>
          <div class="palette-name">Ice</div>
          <div class="palette-hex">#f4f6f8</div>
        </div>
      </div>
    </div>
  </section>
</body>
</html>

---
/**
 * T2 - All-Caps Editorial
 * Modern Editorial Typography with Letter-Spacing
 * Base: V24 Dark Luxury
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>T2: All-Caps Editorial | Typografie-Variante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-gold: #c9a962;
      --color-navy: #0a1628;
      --color-navy-light: #132238;
      --color-cream: #f9f7f3;
      --font-sans: 'Inter', -apple-system, sans-serif;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-cream);
      background: var(--color-navy);
      line-height: 1.6;
    }

    .variant-tag {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--color-gold);
      color: var(--color-navy);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.7rem;
      font-weight: 600;
      z-index: 100;
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header */
    .header {
      padding: 40px 0;
      border-bottom: 1px solid rgba(201, 169, 98, 0.15);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      text-decoration: none;
    }

    .logo-text {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--color-cream);
      text-transform: uppercase;
      letter-spacing: 0.3em;
    }

    .nav {
      display: flex;
      gap: 40px;
    }

    .nav a {
      color: rgba(249, 247, 243, 0.5);
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      transition: color 0.2s;
    }

    .nav a:hover, .nav a.active {
      color: var(--color-gold);
    }

    /* Hero */
    .hero {
      padding: 140px 0 120px;
      text-align: center;
    }

    .hero-tag {
      display: inline-block;
      color: var(--color-gold);
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4em;
      margin-bottom: 40px;
      position: relative;
    }

    .hero-tag::before,
    .hero-tag::after {
      content: "";
      position: absolute;
      top: 50%;
      width: 60px;
      height: 1px;
      background: rgba(201, 169, 98, 0.3);
    }

    .hero-tag::before { right: calc(100% + 20px); }
    .hero-tag::after { left: calc(100% + 20px); }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: 4.5rem;
      font-weight: 400;
      line-height: 1.05;
      color: var(--color-cream);
      margin-bottom: 32px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .hero h1 span {
      display: block;
      font-size: 1.5rem;
      font-family: var(--font-sans);
      font-weight: 300;
      letter-spacing: 0.3em;
      color: var(--color-gold);
      margin-top: 16px;
    }

    .hero .lead {
      font-size: 1rem;
      color: rgba(249, 247, 243, 0.6);
      line-height: 1.8;
      max-width: 500px;
      margin: 0 auto 48px;
      font-weight: 300;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 18px 40px;
      font-weight: 500;
      font-size: 0.7rem;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      transition: all 0.2s;
      border: 1px solid var(--color-gold);
    }

    .btn-primary {
      background: transparent;
      color: var(--color-gold);
    }

    .btn-primary:hover {
      background: var(--color-gold);
      color: var(--color-navy);
    }

    /* Features */
    .features {
      padding: 100px 0;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
    }

    .section-label {
      text-align: center;
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--color-gold);
      text-transform: uppercase;
      letter-spacing: 0.4em;
      margin-bottom: 60px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: rgba(201, 169, 98, 0.1);
    }

    .feature-card {
      background: var(--color-navy);
      padding: 48px 32px;
      text-align: center;
    }

    .feature-number {
      font-family: var(--font-serif);
      font-size: 3rem;
      color: rgba(201, 169, 98, 0.2);
      line-height: 1;
      margin-bottom: 24px;
    }

    .feature-card h3 {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--color-cream);
      text-transform: uppercase;
      letter-spacing: 0.25em;
      margin-bottom: 16px;
    }

    .feature-card p {
      color: rgba(249, 247, 243, 0.55);
      font-size: 0.9rem;
      line-height: 1.7;
      font-weight: 300;
    }

    /* Typography Info */
    .typo-info {
      padding: 80px 0;
      border-top: 1px solid rgba(201, 169, 98, 0.1);
      text-align: center;
    }

    .typo-info h2 {
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--color-gold);
      text-transform: uppercase;
      letter-spacing: 0.4em;
      margin-bottom: 40px;
    }

    .font-sample {
      display: flex;
      justify-content: center;
      gap: 80px;
    }

    .font-sample div {
      text-align: center;
    }

    .font-sample h4 {
      font-size: 0.6rem;
      color: rgba(249, 247, 243, 0.4);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 12px;
    }

    .sample-serif {
      font-family: var(--font-serif);
      font-size: 2.5rem;
      color: var(--color-cream);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .sample-sans {
      font-family: var(--font-sans);
      font-size: 1rem;
      color: var(--color-cream);
      text-transform: uppercase;
      letter-spacing: 0.25em;
      font-weight: 300;
    }

    @media (max-width: 768px) {
      .nav { display: none; }
      .hero h1 { font-size: 2.5rem; }
      .hero h1 span { font-size: 1rem; }
      .features-grid { grid-template-columns: 1fr; }
      .font-sample { flex-direction: column; gap: 40px; }
    }
  </style>
</head>
<body>
  <div class="variant-tag">T2: Editorial Caps</div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-text">Susanne Hoppe</span>
        </a>
        <nav class="nav">
          <a href="#" class="active">Home</a>
          <a href="#">Über mich</a>
          <a href="#">Leistungen</a>
          <a href="#">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-tag">Mobile Kinderosteopathie</div>
      <h1>Osteopathie<br>für Kinder
        <span>Bei Ihnen Zuhause in Leipzig</span>
      </h1>
      <p class="lead">
        Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien.
      </p>
      <a href="#" class="btn btn-primary">Termin Anfragen</a>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="section-label">Leistungen</div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-number">01</div>
          <h3>Hausbesuche</h3>
          <p>Entspannte Behandlung in vertrauter Umgebung für Ihr Kind.</p>
        </div>
        <div class="feature-card">
          <div class="feature-number">02</div>
          <h3>Klinische Expertise</h3>
          <p>Tätig auf einer Neugeborenenstation mit medizinischer Erfahrung.</p>
        </div>
        <div class="feature-card">
          <div class="feature-number">03</div>
          <h3>Familienbegleitung</h3>
          <p>Ganzheitliche Begleitung für Kinder und ihre Familien.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="typo-info">
    <div class="container">
      <h2>Typografie dieser Variante</h2>
      <div class="font-sample">
        <div>
          <h4>Serif (Headlines)</h4>
          <p class="sample-serif">Cormorant</p>
        </div>
        <div>
          <h4>Sans-Serif (Body)</h4>
          <p class="sample-sans">Inter Light</p>
        </div>
      </div>
    </div>
  </section>
</body>
</html>

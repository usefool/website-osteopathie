---
/**
 * T12 - Spectral Modern
 * Spectral Serif + Outfit Sans
 * T5 inspired high contrast palette
 */
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>T12: Spectral Modern | Typografie-Variante</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
  <style>
    :root {
      /* High contrast palette */
      --color-gold: #e5c860;
      --color-gold-bright: #f0d470;
      --color-navy: #050810;
      --color-navy-light: #0a0f18;
      --color-white: #ffffff;
      --font-sans: 'Outfit', -apple-system, sans-serif;
      --font-serif: 'Spectral', Georgia, serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      color: var(--color-white);
      background: var(--color-navy);
      line-height: 1.6;
    }

    .variant-tag {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--color-gold);
      color: var(--color-navy);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 600;
      z-index: 100;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header */
    .header {
      padding: 28px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .logo-icon {
      width: 46px;
      height: 46px;
      background: linear-gradient(135deg, var(--color-gold), var(--color-gold-bright));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-navy);
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.25rem;
    }

    .logo-text {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--color-white);
    }

    .nav {
      display: flex;
      gap: 32px;
    }

    .nav a {
      color: rgba(255, 255, 255, 0.5);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav a:hover {
      color: var(--color-white);
    }

    .nav a.active {
      color: var(--color-gold);
    }

    /* Hero */
    .hero {
      padding: 120px 0 100px;
      position: relative;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -50px;
      right: -100px;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(229, 200, 96, 0.05), transparent 70%);
      pointer-events: none;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .hero-text .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(229, 200, 96, 0.1);
      border: 1px solid rgba(229, 200, 96, 0.2);
      color: var(--color-gold);
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 24px;
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: 3.75rem;
      font-weight: 500;
      line-height: 1.1;
      color: var(--color-white);
      margin-bottom: 24px;
    }

    .hero h1 span {
      color: var(--color-gold-bright);
    }

    .hero .lead {
      font-size: 1.15rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
      margin-bottom: 36px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 32px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      border-radius: 10px;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--color-gold);
      color: var(--color-navy);
    }

    .btn-primary:hover {
      background: var(--color-gold-bright);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(229, 200, 96, 0.2);
    }

    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .visual-card {
      width: 280px;
      height: 340px;
      background: var(--color-navy-light);
      border: 1px solid rgba(229, 200, 96, 0.15);
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 32px;
    }

    .visual-icon {
      width: 80px;
      height: 80px;
      background: rgba(229, 200, 96, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }

    .visual-icon svg {
      width: 36px;
      height: 36px;
      stroke: var(--color-gold);
    }

    .visual-text {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.6);
      font-style: italic;
      line-height: 1.6;
    }

    /* Features */
    .features {
      padding: 100px 0;
      background: var(--color-navy-light);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      background: var(--color-navy);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      padding: 32px 24px;
      text-align: center;
      transition: all 0.3s;
    }

    .feature-card:hover {
      border-color: var(--color-gold);
      transform: translateY(-4px);
    }

    .feature-icon {
      width: 52px;
      height: 52px;
      background: rgba(229, 200, 96, 0.1);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .feature-icon svg {
      width: 26px;
      height: 26px;
      stroke: var(--color-gold);
    }

    .feature-card h3 {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--color-white);
      margin-bottom: 10px;
    }

    .feature-card p {
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* Typography Info */
    .typo-info {
      padding: 80px 0;
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .typo-info h2 {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--color-gold);
      margin-bottom: 40px;
    }

    .font-sample {
      display: flex;
      justify-content: center;
      gap: 80px;
    }

    .font-sample div { text-align: left; }

    .font-sample h4 {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 8px;
    }

    .sample-serif {
      font-family: var(--font-serif);
      font-size: 2.25rem;
      font-weight: 500;
      color: var(--color-white);
    }

    .sample-sans {
      font-family: var(--font-sans);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--color-white);
    }

    /* Color Palette */
    .color-palette {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 48px;
    }

    .palette-item { text-align: center; }

    .palette-swatch {
      width: 60px;
      height: 60px;
      border-radius: 12px;
      margin-bottom: 8px;
      border: 2px solid rgba(255, 255, 255, 0.1);
    }

    .palette-name {
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 2px;
    }

    .palette-hex {
      font-size: 0.65rem;
      color: var(--color-gold);
      font-family: monospace;
    }

    @media (max-width: 1024px) {
      .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-visual { display: none; }
    }

    @media (max-width: 768px) {
      .nav { display: none; }
      .hero h1 { font-size: 2.5rem; }
      .features-grid { grid-template-columns: 1fr; }
      .font-sample { flex-direction: column; gap: 32px; align-items: center; }
      .color-palette { flex-wrap: wrap; }
    }
  </style>
</head>
<body>
  <div class="variant-tag">T12: Spectral Modern</div>

  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <div class="logo-icon">SH</div>
          <span class="logo-text">Susanne Hoppe</span>
        </a>
        <nav class="nav">
          <a href="#" class="active">Home</a>
          <a href="#">Über mich</a>
          <a href="#">Leistungen</a>
          <a href="#">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <div class="hero-tag">Mobile Kinderosteopathie</div>
          <h1>Sanfte <span>Osteopathie</span> für Ihr Kind</h1>
          <p class="lead">
            Begleitende osteopathische Behandlung für Säuglinge, Kinder und ihre Familien –
            einfühlsam und bei Ihnen zuhause in Leipzig.
          </p>
          <a href="#" class="btn btn-primary">Termin anfragen</a>
        </div>
        <div class="hero-visual">
          <div class="visual-card">
            <div class="visual-icon">
              <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <p class="visual-text">
              Sanfte Hände,<br>
              große Wirkung
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <h3>Bei Ihnen zuhause</h3>
          <p>Entspannte Behandlung in vertrauter Umgebung für Ihr Kind.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5"/>
            </svg>
          </div>
          <h3>Klinische Erfahrung</h3>
          <p>Tätig auf einer Neugeborenenstation mit medizinischer Expertise.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <h3>Für die Familie</h3>
          <p>Ganzheitliche Begleitung für Kinder und ihre Familien.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="typo-info">
    <div class="container">
      <h2>Typografie & Farben dieser Variante</h2>
      <div class="font-sample">
        <div>
          <h4>Serif (Headlines)</h4>
          <p class="sample-serif">Spectral</p>
        </div>
        <div>
          <h4>Sans-Serif (Body)</h4>
          <p class="sample-sans">Outfit</p>
        </div>
      </div>
      <div class="color-palette">
        <div class="palette-item">
          <div class="palette-swatch" style="background: #050810;"></div>
          <div class="palette-name">Deep Black</div>
          <div class="palette-hex">#050810</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #e5c860;"></div>
          <div class="palette-name">Gold</div>
          <div class="palette-hex">#e5c860</div>
        </div>
        <div class="palette-item">
          <div class="palette-swatch" style="background: #ffffff;"></div>
          <div class="palette-name">White</div>
          <div class="palette-hex">#ffffff</div>
        </div>
      </div>
    </div>
  </section>
</body>
</html>
